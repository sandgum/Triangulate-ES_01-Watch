              "variable": "roller_items[index]",
              "value": "`${(Math.floor(today_timetable_events[index].time_start_MinSinMid / 60) % 12) == 0 ? 12 : ((Math.floor(today_timetable_events[index].time_start_MinSinMid / 60) % 12) < 10 ? \"0\" + (Math.floor(today_timetable_events[index].time_start_MinSinMid / 60) % 12) : (Math.floor(today_timetable_events[index].time_start_MinSinMid / 60) % 12))}:${(today_timetable_events[index].time_start_MinSinMid % 60) < 10 ? \"0\" + (today_timetable_events[index].time_start_MinSinMid % 60) : (today_timetable_events[index].time_start_MinSinMid % 60)} - ${today_timetable_events[index].name}`"
            }
          ]
